{
  "name": "orgapp",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "author": "System Admins",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:teams": "node scripts/package-teams-app.mjs",
    "package:sharepoint": "node scripts/package-sharepoint-app.mjs",
    "deploy": "npm run build && swa deploy dist --env production"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.23.0",
    "@microsoft/teams-js": "^2.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^2.0.10",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@azure/static-web-apps-cli": {
      "adm-zip": "^0.6.1",
      "selfsigned": "^5.5.0",
      "devcert": {
        "tmp": "^0.2.7"
      }
    }
  },
  "allowScripts": {
    "fsevents": false,
    "keytar": false
  }
}
