{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.22/MicrosoftTeams.schema.json",
  "manifestVersion": "1.22",
  "version": "{{VERSION}}",
  "id": "{{CLIENT_ID}}",
  "developer": {
    "name": "{{DEVELOPER}}",
    "websiteUrl": "https://{{HOST}}/",
    "privacyUrl": "https://{{HOST}}/",
    "termsOfUseUrl": "https://{{HOST}}/"
  },
  "name": {
    "short": "{{SHORT_NAME}}",
    "full": "{{FULL_NAME}}"
  },
  "description": {
    "short": "Browse the organization chart and find colleagues.",
    "full": "Shows the organization chart from Microsoft Entra ID with name, job title, department, e-mail and phone for every employee. Search for colleagues and expand or collapse teams."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "{{ACCENT}}",
  "staticTabs": [
    {
      "entityId": "orgchart",
      "name": "{{SHORT_NAME}}",
      "contentUrl": "https://{{HOST}}/?host=teams",
      "websiteUrl": "https://{{HOST}}/",
      "scopes": ["personal"]
    }
  ],
  "configurableTabs": [
    {
      "configurationUrl": "https://{{HOST}}/?host=teams&view=tab-config",
      "canUpdateConfiguration": true,
      "scopes": ["team", "groupChat"],
      "context": ["channelTab", "privateChatTab", "meetingChatTab", "meetingDetailsTab"]
    }
  ],
  "permissions": ["identity"],
  "validDomains": ["{{HOST}}"],
  "webApplicationInfo": {
    "id": "{{CLIENT_ID}}"
  }
}
