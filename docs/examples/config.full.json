      "unlicensed": true,
      "withoutJobTitle": false,
      "hiddenFromAddressList": true,
      "unattached": false
    },
    "expandDepth": 2,
    "startAt": "me",
    "showPhotos": true,
    "showPresence": true,
    "showWorkLocation": true,
    "showWorkingHours": true,
    "showLevels": false
  },
  "contact": {
    "emailClient": "outlookWeb"
  },
  "account": {
    "changePhotoUrl": "https://myaccount.microsoft.com/"
  },
  "support": {
    "url": "mailto:servicedesk@contoso.com",
